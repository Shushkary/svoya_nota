# Локальная конфигурация ИИ-оценки КБЖУ. Скопируйте этот файл в app/server/.env
# и подставьте свой ключ. Файл .env НЕ коммитить (в нём секрет).
#
# Без этих переменных сервер работает в режиме fail-closed: ИИ выключен,
# «Оценить по описанию»/«Фото блюда» вернут «ИИ-анализ на сервере выключен» —
# это ожидаемо, а не ошибка. Ручной ввод и штрих-код работают без ключа.
#
# После создания/изменения .env перезапустите сервер nota-api.

NOTA_LLM_PROVIDER=aitunnel
NOTA_LLM_API_KEY=вставьте_сюда_ключ_aitunnel
NOTA_LLM_URL=https://api.aitunnel.ru/v1
# Модели (необязательно — значения по умолчанию заданы в composition.py):
# NOTA_TEXT_MODEL=gemini-3.1-flash-lite
# NOTA_VISION_MODEL=gemini-2.5-flash
NOTA_LLM_TIMEOUT=60
